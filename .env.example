# =============================================================================
# MemGuard XAI - Ortam Değişkenleri Şablonu (.env.example)
# =============================================================================
# Bu dosya, projede kullanılan yapılandırma parametrelerini gösteren şablondur.
# Gerçek değerler için bu dosyayı '.env' olarak kopyalayabilir ve düzenleyebilirsiniz.

# Uygulama Çalışma Ortamı (development / production)
MEMGUARD_ENV=production

# Streamlit Sunucu Yapılandırması
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# Veri ve Model Yolları
DATASET_PATH=data/Obfuscated-MalMem2022.csv
OUTPUTS_DIR=outputs/
MODEL_SAVE_PATH=outputs/best_model.joblib
MULTICLASS_MODEL_PATH=outputs/multiclass_model.joblib

# SHAP Açıklanabilirlik Motoru Parametreleri
SHAP_EXPLAINER_SAMPLE_SIZE=1500
SHAP_RANDOM_STATE=42

# Günlükleme (Logging) Düzeyi (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
